# GlitchTip settings. Copy to .env next to compose.yml, never commit the real one.
# Make the two secrets with: openssl rand -hex 32
SECRET_KEY=
POSTGRES_PASSWORD=
GLITCHTIP_DOMAIN=https://errors.reece.page
DEFAULT_FROM_EMAIL=errors@reece.page
# Alert emails, through Proton Mail Bridge on the host or a Proton SMTP token, for example:
# EMAIL_URL=smtp+tls://errors%40reece.page:TOKEN@smtp.protonmail.ch:587
EMAIL_URL=consolemail://
# How long error events are kept, the privacy policy says 30 days
GLITCHTIP_MAX_EVENT_LIFE_DAYS=30
# Turn this to False after making your own account, so nobody else can sign up
ENABLE_USER_REGISTRATION=True
