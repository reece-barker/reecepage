{
  "name": "reece-page",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "csrf-csrf": "^4.0.3",
    "express": "^5.3.0",
    "express-handlebars": "^8.0.1",
    "express-rate-limit": "^8.7.1",
    "gray-matter": "^4.0.3",
    "helmet": "^8.3.0",
    "js-yaml": "^5.4.3",
    "marked": "^18.1.1",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.1.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "umzug": "^3.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "axe-core": "^4.14.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "gulp": "^5.0.1",
    "sass": "^1.105.1",
    "supertest": "^7.3.1",
    "svgo": "^4.1.0",
    "terser": "^5.51.2"
  },
  "description": "reece.page, the personal website of Reece Barker. Express, Handlebars, Sass, Gulp, MySQL.",
  "author": "Reece Norman Barker <me@reece.page>",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "node --disable-warning=ExperimentalWarning src/server.js",
    "build": "gulp build --production",
    "build:dev": "gulp build",
    "lint": "eslint .",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 --test-reporter=spec \"tests/unit/**/*.test.js\" \"tests/integration/**/*.test.js\"",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run content:check",
    "content:check": "node --disable-warning=ExperimentalWarning scripts/content-check.js",
    "site:check": "node --disable-warning=ExperimentalWarning scripts/site-check.js",
    "db:migrate": "node --disable-warning=ExperimentalWarning scripts/db.js migrate",
    "db:rollback": "node --disable-warning=ExperimentalWarning scripts/db.js rollback",
    "db:status": "node --disable-warning=ExperimentalWarning scripts/db.js status",
    "db:seed": "node --disable-warning=ExperimentalWarning scripts/db.js seed",
    "contact:list": "node --disable-warning=ExperimentalWarning scripts/contact.js list",
    "contact:purge": "node --disable-warning=ExperimentalWarning scripts/contact.js purge",
    "contact:retry": "node --disable-warning=ExperimentalWarning scripts/contact.js retry",
    "mail:verify": "node --disable-warning=ExperimentalWarning scripts/mail-verify.js",
    "secret": "node -e \"console.log(require('node:crypto').randomBytes(48).toString('base64url'))\"",
    "images:tree": "node --disable-warning=ExperimentalWarning scripts/make-tree-posters.js",
    "images:og": "node --disable-warning=ExperimentalWarning scripts/make-og-images.js",
    "perf:check": "node --disable-warning=ExperimentalWarning scripts/perf-check.js",
    "screenshots": "node --disable-warning=ExperimentalWarning scripts/screenshots.js",
    "media:add": "node --disable-warning=ExperimentalWarning scripts/media-add.js",
    "admin:password": "node scripts/admin-password.js",
    "cv:pdf": "node --disable-warning=ExperimentalWarning scripts/make-cv-pdf.js",
    "media:import": "node --disable-warning=ExperimentalWarning scripts/media-import.js"
  }
}
