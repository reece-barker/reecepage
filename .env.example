# Copy this file to .env and fill it in. .env is never committed.
# Settings that arent secret (texts, feature flags, retention) live in config/application.yml instead.
# Real environment variables always win over this file.

# development, test or production
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
# The public address, no trailing slash. Production refuses to start without https here
BASE_URL=http://localhost:3000
# How many proxies sit in front of the app (nginx = 1). Rate limits need it to see the real visitor
TRUST_PROXY=0
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=

# Signs the contact form tokens and the CSRF cookie. Make one with: npm run secret
APP_SECRET=

# Database. mysql in production, sqlite (the default outside production) for local development, none to run without one
DB_DIALECT=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=reece_page
DB_USER=reece_page
DB_PASSWORD=
DB_SSL=false
DB_POOL_MAX=5
DB_LOG_QUERIES=false
# Only for DB_DIALECT=sqlite
DB_STORAGE=var/dev.sqlite

# Outgoing email for contact form notifications. See docs/EMAIL.md before picking a provider
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (TLS from the start), false for 587 (STARTTLS, which is then required)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# Proton Mail Bridge on the same server: SMTP_HOST=127.0.0.1, SMTP_PORT=1025, SMTP_SECURE=false and this set to true
# (Bridge uses a self signed certificate, which is only accepted for 127.0.0.1). See docs/EMAIL.md
SMTP_ALLOW_SELF_SIGNED=false
# The sender address, must be allowed by the SMTP account, for example "reece.page <website@reece.page>"
MAIL_FROM=
# Where notifications go, defaults to site.email from the YAML
CONTACT_NOTIFY_TO=

# Only printed on the impressum when legal.owner.show_phone is true in the YAML
LEGAL_PHONE=

# Feature flags can be flipped per environment without touching the YAML, for example FEATURE_TOOLS=true
# FEATURE_WRITING=
# FEATURE_CONTACT_FORM=
# FEATURE_TOOLS=
# FEATURE_ANALYTICS=

# none, plausible or umami (also needs FEATURE_ANALYTICS=true, and only runs after consent)
ANALYTICS_PROVIDER=

# Media library: where uploaded pictures and videos are stored (back this folder up), and the upload limits
MEDIA_DIR=var/media
MEDIA_MAX_IMAGE_MB=20
MEDIA_MAX_VIDEO_MB=1024

# Signing in to /admin with SimpleLogin (Proton). Make an app on https://app.simplelogin.io/developer with the
# redirect address https://reece.page/admin/login/simplelogin/callback and copy its id and secret here
SIMPLELOGIN_CLIENT_ID=
SIMPLELOGIN_CLIENT_SECRET=
# Only this SimpleLogin account gets in. Leave it empty, sign in once and the page shows the id to put here
ADMIN_SIMPLELOGIN_ID=
# How long a sign in lasts in days, and after how many days without using the admin it ends anyway
ADMIN_SESSION_DAYS=14
ADMIN_IDLE_DAYS=3
# The one click development sign in on your own computer (never in production), false switches it off
ADMIN_DEV_LOGIN=

# Saving in the admin also commits the content files to GitHub. A fine grained token with Contents read and write
# on the reecepage repository only. Empty means no commits, the database still has everything
GITHUB_SYNC_TOKEN=
GITHUB_SYNC_REPO=reece-barker/reecepage
GITHUB_SYNC_BRANCH=main

# Error monitoring with the self hosted GlitchTip (deploy/glitchtip). Empty means off
ERROR_DSN=
# Shown with every error report, for example the git commit of the deploy
RELEASE=
# Also forward errors from visitors' browsers (true or false)
ERROR_REPORT_BROWSER=true
