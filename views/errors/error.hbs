<div class="container error-page">
  <div class="fallen-leaf" aria-hidden="true"></div>
  <h1>{{title}}</h1>
  {{#if isCsrf}}
  <p class="lead">{{t "errors.csrfText"}}</p>
  <div class="cluster"><a class="button" href="{{lp "/contact"}}">{{t "errors.csrfButton"}} {{icon "arrow"}}</a></div>
  {{else if (eq status 429)}}
  <p class="lead">{{tMail "errors.slowText" site.email wait=(waitText retryMinutes)}}</p>
  <div class="cluster"><a class="button" href="{{lp "/"}}">{{t "errors.homePage"}} {{icon "arrow"}}</a></div>
  {{else}}
  <p class="lead">{{tMail "errors.failText" site.email}}</p>
  {{#if requestId}}<p class="muted">{{t "errors.reference"}} <code>{{requestId}}</code></p>{{/if}}
  <div class="cluster"><a class="button" href="{{lp "/"}}">{{t "errors.homePage"}} {{icon "arrow"}}</a></div>
  {{/if}}
</div>
