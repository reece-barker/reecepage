<header class="admin-head">
  <div class="admin-head__text">
    <h1>{{schema.title}}</h1>
    {{#if lede}}<p class="admin-head__lede">{{lede}}</p>{{/if}}
  </div>
  {{#unless schema.fixed}}<div class="admin-head__actions"><a class="button" href="/admin/{{type}}/new">{{icon "plus"}}New {{schema.singular}}</a></div>{{/unless}}
</header>

{{#if (eq notice "trashed")}}<p class="alert alert--success" role="status">{{icon "check"}}<span>Moved to the trash. It's off the site, and you can restore it from the Trash tab.</span></p>{{/if}}
{{#if (eq notice "restored")}}<p class="alert alert--success" role="status">{{icon "check"}}<span>Restored as a draft. Open it and publish when you're ready.</span></p>{{/if}}
{{#if (eq notice "deleted")}}<p class="alert alert--success" role="status">{{icon "check"}}<span>Deleted for good, with its revisions.</span></p>{{/if}}
{{#if (eq notice "failed")}}<p class="alert alert--error" role="alert">{{icon "alert"}}<span>That didnt work, it may have been changed in another tab. Reload and try again.</span></p>{{/if}}
{{#if (eq notice "restore-failed")}}<p class="alert alert--error" role="alert">{{icon "alert"}}<span>It couldnt be restored, something else uses the same address now. Rename that one first.</span></p>{{/if}}

<section class="panel" aria-label="{{schema.title}}">
  {{#unless schema.fixed}}
  <div class="admin-toolbar">
    <nav class="admin-tabs" aria-label="Filter by status">
      {{#each tabs}}<a class="admin-tabs__tab{{#if current}} is-current{{/if}}" href="{{href}}"{{#if current}} aria-current="page"{{/if}}>{{label}}<span class="admin-tabs__count">{{count}}</span></a>{{/each}}
    </nav>
    <form class="admin-search" method="get" action="/admin/{{type}}" role="search">
      {{#unless (eq filter "all")}}<input type="hidden" name="status" value="{{filter}}">{{/unless}}
      <label class="visually-hidden" for="admin-search">Search {{schema.title}}</label>
      <input class="input" id="admin-search" type="search" name="q" value="{{search}}" placeholder="Search by title">
      <button class="button button--secondary button--small" type="submit">Search</button>
    </form>
  </div>
  {{/unless}}

  {{#if items.length}}
  <table class="admin-table admin-table--entries">
    <thead><tr><th scope="col">Title</th><th scope="col">Status</th><th scope="col">Changed</th><th scope="col"><span class="visually-hidden">Actions</span></th></tr></thead>
    <tbody>
      {{#each items}}
      <tr>
        <td>
          {{#if (eq state "trash")}}<span class="admin-table__title">{{title}}</span>{{else}}<a class="admin-table__title" href="/admin/{{type}}/{{id}}">{{title}}</a>{{/if}}
          <span class="admin-table__sub">{{url}}{{#if branch}}, {{branch}}{{/if}}</span>
        </td>
        <td><span class="pill pill--{{state}}">{{stateLabel}}</span>{{#if (eq state "scheduled")}}<span class="admin-table__sub"><time datetime="{{publishAt}}" data-local-time>{{publishAt}}</time></span>{{/if}}</td>
        <td class="admin-table__when"><time datetime="{{updatedAt}}" data-local-time>{{updatedAt}}</time></td>
        <td>
          <div class="admin-table__actions">
            {{#if (eq state "trash")}}
            <form method="post" action="/admin/{{type}}/{{id}}/restore"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="qbutton" type="submit">Restore</button></form>
            <form method="post" action="/admin/{{type}}/{{id}}/delete" data-confirm-form><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="qbutton qbutton--danger" type="submit" data-confirm-label="Press again to delete for good">{{icon "trash"}}Delete for good</button></form>
            {{else}}
            {{#if (eq state "published")}}<a class="qbutton" href="{{url}}" target="_blank" rel="noopener">{{icon "eye"}}View<span class="visually-hidden"> {{title}} on the site</span></a>{{/if}}
            <a class="qbutton" href="/admin/{{type}}/{{id}}/revisions">{{icon "clock"}}Revisions<span class="visually-hidden"> of {{title}}</span></a>
            {{#unless @root.schema.fixed}}
            <form method="post" action="/admin/{{type}}/{{id}}/trash" data-confirm-form><input type="hidden" name="_csrf" value="{{@root.csrfToken}}"><button class="qbutton qbutton--danger" type="submit" data-confirm-label="Press again to move to the trash">{{icon "trash"}}Trash<span class="visually-hidden"> {{title}}</span></button></form>
            {{/unless}}
            {{/if}}
          </div>
        </td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <div class="admin-empty admin-empty--big">
    {{icon "page"}}
    {{#if search}}<p>Nothing matches "{{search}}".</p><p><a href="/admin/{{type}}">Show everything</a></p>
    {{else if (eq filter "trash")}}<p>The trash is empty.</p>
    {{else if (eq filter "all")}}<p>No {{lower schema.title}} yet.</p>{{#unless schema.fixed}}<p><a class="button" href="/admin/{{type}}/new">Write the first {{schema.singular}}</a></p>{{/unless}}
    {{else}}<p>Nothing here right now.</p>{{/if}}
  </div>
  {{/if}}
</section>
