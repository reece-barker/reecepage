<header class="admin-head">
  <div class="admin-head__text">
    <h1>Dashboard</h1>
    <p class="admin-head__lede">What's on the site, what's waiting, and what changed last.</p>
  </div>
  <div class="admin-head__actions">
    {{#each cards}}<a class="button{{#unless @first}} button--secondary{{/unless}}" href="{{href}}/new">{{icon "plus"}}New {{singular}}</a>{{/each}}
  </div>
</header>

{{#if (eq source "files")}}
<p class="alert alert--error" role="alert">{{icon "alert"}}<span>The site is showing the files from content/ because the database couldnt be read. Changes saved here wont show until it can, see Status and links.</span></p>
{{/if}}

<ul class="admin-stats" role="list" data-stats="{{statCount}}">
  {{#each cards}}
  <li><a class="admin-stat" href="{{href}}">
    <span class="admin-stat__label">{{icon icon}}{{title}}</span>
    <span class="admin-stat__number">{{count}}</span>
    <span class="admin-stat__note">published{{#if drafts}}, {{drafts}} {{plural drafts "draft" "drafts"}}{{/if}}</span>
  </a></li>
  {{/each}}
  {{#if hasMedia}}
  <li><a class="admin-stat" href="/admin/library">
    <span class="admin-stat__label">{{icon "image"}}Media</span>
    <span class="admin-stat__number">{{mediaCount}}</span>
    <span class="admin-stat__note">{{mediaPublished}} on the media page</span>
  </a></li>
  {{/if}}
</ul>

<div class="admin-split admin-split--side-first">
  <section class="panel" aria-labelledby="recent-title">
    <div class="panel__head"><h2 id="recent-title">Recently changed</h2></div>
    {{#if recent.length}}
    <ul class="admin-rows" role="list">
      {{#each recent}}
      <li class="admin-row">
        <div class="admin-row__main">
          <a href="/admin/{{type}}/{{id}}">{{title}}</a>
          <div class="admin-row__meta">{{typeLabel}}, changed <time datetime="{{updatedAt}}" data-local-time>{{updatedAt}}</time></div>
        </div>
        <span class="pill pill--{{state}}">{{stateLabel}}</span>
      </li>
      {{/each}}
    </ul>
    {{else}}
    <p class="panel__body admin-empty">Nothing yet. Write something and it shows up here.</p>
    {{/if}}
  </section>

  <div class="stack">
    <section class="panel" aria-labelledby="drafts-title">
      <div class="panel__head"><h2 id="drafts-title">Drafts <span class="panel__count">{{drafts.length}}</span></h2></div>
      {{#if drafts.length}}
      <ul class="admin-rows" role="list">
        {{#each drafts}}
        <li class="admin-row"><div class="admin-row__main"><a href="/admin/{{type}}/{{id}}">{{title}}</a><div class="admin-row__meta">{{typeLabel}}, <time datetime="{{updatedAt}}" data-local-time>{{updatedAt}}</time></div></div></li>
        {{/each}}
      </ul>
      {{else}}
      <p class="panel__body admin-empty">No drafts, everything you started is on the site.</p>
      {{/if}}
    </section>

    <section class="panel" aria-labelledby="soon-title">
      <div class="panel__head"><h2 id="soon-title">Scheduled <span class="panel__count">{{scheduled.length}}</span></h2></div>
      {{#if scheduled.length}}
      <ul class="admin-rows" role="list">
        {{#each scheduled}}
        <li class="admin-row"><div class="admin-row__main"><a href="/admin/{{type}}/{{id}}">{{title}}</a><div class="admin-row__meta">goes live <time datetime="{{publishAt}}" data-local-time>{{publishAt}}</time></div></div></li>
        {{/each}}
      </ul>
      {{else}}
      <p class="panel__body admin-empty">Nothing scheduled. Set a publish time under Details in the editor to put something here.</p>
      {{/if}}
    </section>

    <section class="panel" aria-labelledby="sync-title">
      <div class="panel__head"><h2 id="sync-title">GitHub</h2><a href="/admin/sync">Details</a></div>
      <div class="panel__body">
        {{#if syncEnabled}}
        <p>{{#if (eq sync.state "ok")}}<span class="pill pill--published">Up to date</span>{{else if (eq sync.state "failed")}}<span class="pill pill--scheduled">Failed</span> {{sync.lastError.message}}{{else}}<span class="pill">Waiting</span> Copying the latest changes soon.{{/if}}</p>
        {{else}}
        <p><span class="pill">Off</span></p>
        <p class="admin-row__meta">Saves arent copied to GitHub here because GITHUB_SYNC_TOKEN isnt set. Normal on your own computer.</p>
        {{/if}}
        {{#if (eq signedInWith "dev")}}<p class="admin-row__meta">Signed in with the development sign in.</p>{{/if}}
      </div>
    </section>
  </div>
</div>
