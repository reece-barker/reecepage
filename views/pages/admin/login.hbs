{{!-- The sign in page: the brand on the left (a band on top on a phone), the ways in on the right. Only Reece has
an account, so it says that up front and gives everyone else a way back to the site --}}
<div class="signin">
  <aside class="signin__brand" aria-label="reece.page">
    <a class="signin__home" href="/">
      <img src="{{asset "images/brand/reece-dove-symbol-colour-on-dark.svg"}}" alt="" width="40" height="32">
      <span>reece.page</span>
    </a>
    <p class="signin__slogan">Code for a living world.</p>
    <p class="signin__about">The admin behind the site: writing, projects, the CV and paperwork.</p>
    <img class="signin__leaves" src="{{asset "images/brand/leaf-band.svg"}}" alt="" width="240" height="16">
  </aside>

  <section class="signin__panel" aria-labelledby="signin-title">
    <h1 id="signin-title">Sign in</h1>
    <p class="signin__lede">This part of the site is only for Reece. Looking for his work? <a href="/projects">See the projects</a>.</p>

    {{#if error}}<p class="alert alert--error" role="alert">{{icon "alert"}}<span>{{error}}</span></p>{{/if}}
    {{#if noDatabase}}
    <p class="alert alert--error" role="alert">{{icon "alert"}}<span>The admin needs the database and this server doesnt have one configured (DB_DIALECT and the DB_* values in .env).</span></p>
    {{else}}
    {{#if nothingSetUp}}
    <div class="alert alert--note">{{icon "info"}}<div><p>Sign in isnt set up on this server yet. Add <code>SIMPLELOGIN_CLIENT_ID</code> and <code>SIMPLELOGIN_CLIENT_SECRET</code> to <code>.env</code> and restart the site, the steps are in docs/DEPLOYMENT.md.</p></div></div>
    {{/if}}

    <div class="signin__options">
      {{#if simplelogin}}
      <form class="signin__option" method="post" action="/admin/login/simplelogin">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="next" value="{{next}}">
        <button class="button signin__button" type="submit" aria-describedby="signin-simplelogin-hint">{{icon "key"}}Sign in with SimpleLogin</button>
        <p class="signin__hint" id="signin-simplelogin-hint">Log in with Proton works there too.</p>
      </form>
      {{/if}}

      {{#if passkeys}}
      <div class="signin__option signin__passkey" data-passkey-signin data-next="{{next}}" hidden>
        <button class="button button--secondary signin__button" type="button" data-passkey-button aria-describedby="signin-passkey-status">{{icon "check"}}Use a passkey</button>
        <p class="signin__hint form-status" id="signin-passkey-status" role="status" aria-live="polite" data-passkey-status>Face ID, Touch ID, Windows Hello or a security key.</p>
      </div>
      {{/if}}

      {{#if dev}}
      <form class="signin__option" method="post" action="/admin/login/dev">
        <input type="hidden" name="_csrf" value="{{csrfToken}}">
        <input type="hidden" name="next" value="{{next}}">
        <button class="button button--secondary signin__button" type="submit" aria-describedby="signin-dev-hint">Development sign in</button>
        <p class="signin__hint" id="signin-dev-hint">Only here on your own computer, never on the server.</p>
      </form>
      {{/if}}
    </div>
    {{/if}}

    <p class="signin__back"><a class="link-action" href="/">Back to the site</a></p>
  </section>
</div>
