<div class="container admin">
  <header class="page-head">
    <h1>Admin</h1>
    <p class="lead">Everything behind reece.page in one place. Only you can see this page.</p>
  </header>

  {{#if devPassword}}
  <div class="alert alert--note">{{icon "info"}}<div><h2 class="h-small">Development login</h2><p>You are signed in with the development password <code>{{devPassword}}</code>, which only works on your own computer. On the server set <code>ADMIN_PASSWORD_HASH</code> (run <code>npm run admin:password</code>).</p></div></div>
  {{/if}}

  <section class="admin-section" aria-labelledby="status-title">
    <div class="section-head"><h2 id="status-title">Status right now</h2><a class="link-action" href="/status">Public status page {{icon "arrow"}}</a></div>
    <ul class="status-list status-list--compact" role="list">
      {{#each status.checks}}
      <li class="status-row status-row--{{state}}"><span class="status-dot" aria-hidden="true"></span><div><h3>{{name}}</h3><p>{{detail}}</p></div><span class="status-label">{{label}}</span></li>
      {{/each}}
    </ul>
  </section>

  <section class="admin-section" aria-labelledby="edit-title">
    <h2 id="edit-title">Content</h2>
    {{#unless editing}}<p class="alert alert--note">{{icon "info"}}<span>Editing is switched off on this server. Edit on your computer (npm run dev, then /admin), commit and deploy. Set <code>CONTENT_EDITING=true</code> to edit here instead.</span></p>{{/unless}}
    <div class="admin-cards">
      {{#each collections}}
      <a class="admin-card" href="/admin/content/{{name}}"><strong>{{title}}</strong><span>{{count}} {{plural count "file" "files"}} in content/{{name}}</span></a>
      {{/each}}
      <a class="admin-card" href="/admin/media"><strong>Media library</strong><span>{{counts.media}} pictures and videos, uploads and the home page video</span></a>
      {{#each dataFiles}}
      <a class="admin-card" href="/admin/data/{{name}}"><strong>{{title}}</strong><span>{{help}}</span></a>
      {{/each}}
    </div>
  </section>

  <section class="admin-section" aria-labelledby="where-title">
    <h2 id="where-title">Where things live</h2>
    <div class="table-scroll" tabindex="0" role="region" aria-label="Where content lives">
      <table class="admin-table">
        <thead><tr><th scope="col">What</th><th scope="col">Edit it here</th><th scope="col">Or the file</th></tr></thead>
        <tbody>
          <tr><td>Projects</td><td><a href="/admin/content/projects">Projects</a></td><td><code>content/projects/&lt;address&gt;.md</code></td></tr>
          <tr><td>Articles</td><td><a href="/admin/content/writing">Writing</a></td><td><code>content/writing/&lt;address&gt;.md</code></td></tr>
          <tr><td>About page story</td><td>by hand</td><td><code>content/pages/about.md</code></td></tr>
          <tr><td>Experience and education</td><td><a href="/admin/data/timeline">Timeline</a></td><td><code>content/data/timeline.yml</code></td></tr>
          <tr><td>Right now</td><td><a href="/admin/data/now">Right now</a></td><td><code>content/data/now.yml</code></td></tr>
          <tr><td>References</td><td><a href="/admin/data/references">References</a></td><td><code>content/data/references.yml</code></td></tr>
          <tr><td>CV</td><td><a href="/admin/data/cv">CV</a></td><td><code>content/data/cv.yml</code>, PDF in <code>content/cv/</code></td></tr>
          <tr><td>Pictures and videos</td><td><a href="/admin/media">Media</a></td><td>files in <code>var/media/</code>, or drop them in <code>media-inbox/</code></td></tr>
          <tr><td>Site details, features, legal facts</td><td>by hand</td><td><code>config/application.yml</code>, secrets in <code>.env</code></td></tr>
        </tbody>
      </table>
    </div>
    <p>A picture or video goes into a project or article with its code, on a line of its own, for example <code>[[media:my-photo-1a2b3c]]</code>. The media library shows each item's code, and the editor has a button that puts it in for you.</p>
  </section>

  <section class="admin-section" aria-labelledby="links-title">
    <h2 id="links-title">Every address on the site</h2>
    {{#each groups}}
    <h3>{{title}}</h3>
    <div class="table-scroll" tabindex="0" role="region" aria-label="{{title}}">
      <table class="admin-table admin-table--endpoints">
        <thead><tr><th scope="col">Method</th><th scope="col">Address</th><th scope="col">What it is for</th></tr></thead>
        <tbody>
          {{#each items}}
          <tr{{#if off}} class="is-off"{{/if}}>
            <td><code>{{method}}</code></td>
            <td>{{#if link}}<a href="{{path}}"><code>{{path}}</code></a>{{else}}<code>{{path}}</code>{{/if}}</td>
            <td>{{what}}{{#if off}} <strong>(switched off)</strong>{{/if}}</td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    {{/each}}
  </section>

  <section class="admin-section" aria-labelledby="ext-title">
    <h2 id="ext-title">Elsewhere</h2>
    <ul class="cluster" role="list">
      {{#each external}}<li><a class="link-action" href="{{url}}" rel="noopener">{{label}} {{icon "external"}}</a></li>{{/each}}
    </ul>
  </section>
</div>
