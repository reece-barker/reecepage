<header class="admin-head">
  <div class="admin-head__text">
    <h1>Documents</h1>
    <p class="admin-head__lede">Letters, invoices, contracts, business cards, compliments slips and your email signature, numbered and kept with every change. Fill in the form, watch the page, download a PDF or a Word file.</p>
  </div>
  <div class="admin-head__actions">
    {{#each kinds}}
    <form class="paperwork-new" method="post" action="/admin/paperwork/new/{{kind}}"><input type="hidden" name="_csrf" value="{{@root.csrfToken}}">
      {{#if choices}}<label class="visually-hidden" for="new-{{kind}}-type">Type of {{lower label}}</label><select class="select paperwork-new__type" id="new-{{kind}}-type" name="type">{{#each choices}}<option value="{{id}}">{{label}}</option>{{/each}}</select>{{/if}}
      <button class="button{{#unless @first}} button--secondary{{/unless}}" type="submit">{{icon "plus"}}New {{lower label}}</button>
    </form>
    {{/each}}
  </div>
</header>

{{#unless hasDetails}}<p class="alert alert--note">{{icon "info"}}<span>Fill in <a href="/admin/lists/business">My details</a> first: your business type decides what has to be printed on letters and invoices. Until then the name and address from the site settings are used.</span></p>{{/unless}}
{{#unless hasAccounts}}<p class="alert alert--note">{{icon "info"}}<span>Add a bank account under <a href="/admin/lists/payment_accounts">Payment accounts</a> to pick it on invoices and payment plans.</span></p>{{/unless}}
{{#if (eq notice "trashed")}}<p class="alert alert--success" role="status">{{icon "check"}}<span>Moved to the trash. Its number stays taken, so no invoice number is ever given out twice.</span></p>{{/if}}

<section class="panel" aria-label="Documents">
  <div class="admin-toolbar">
    <nav class="admin-tabs" aria-label="Filter by kind">
      <a class="admin-tabs__tab{{#unless kind}} is-current{{/unless}}" href="/admin/paperwork"{{#unless kind}} aria-current="page"{{/unless}}>All</a>
      {{#each kinds}}<a class="admin-tabs__tab{{#if current}} is-current{{/if}}" href="/admin/paperwork?kind={{kind}}"{{#if current}} aria-current="page"{{/if}}>{{label}}s</a>{{/each}}
      <a class="admin-tabs__tab{{#if (eq status "trash")}} is-current{{/if}}" href="/admin/paperwork?status=trash">Trash</a>
    </nav>
    <form class="admin-search" method="get" action="/admin/paperwork" role="search">
      {{#if kind}}<input type="hidden" name="kind" value="{{kind}}">{{/if}}
      <label class="visually-hidden" for="paperwork-search">Search documents</label>
      <input class="input" id="paperwork-search" type="search" name="q" value="{{search}}" placeholder="Search by title or number">
      <button class="button button--secondary button--small" type="submit">Search</button>
    </form>
  </div>
  {{#if items.length}}
  <table class="admin-table">
    <thead><tr><th scope="col">Document</th><th scope="col">Number</th><th scope="col">Status</th><th scope="col">Changed</th></tr></thead>
    <tbody>
      {{#each items}}
      <tr>
        <td><a class="admin-table__title" href="/admin/paperwork/{{id}}">{{title}}</a><span class="admin-table__sub">{{kindLabel}}, {{lang}}</span></td>
        <td class="admin-table__when">{{number}}</td>
        <td><span class="pill pill--{{status}}">{{statusLabel}}</span></td>
        <td class="admin-table__when"><time datetime="{{updatedAt}}" data-local-time>{{updatedAt}}</time></td>
      </tr>
      {{/each}}
    </tbody>
  </table>
  {{else}}
  <p class="panel__body admin-empty">{{#if (eq status "trash")}}The trash is empty.{{else}}Nothing yet. Start a letter, an invoice or a contract with the buttons at the top.{{/if}}</p>
  {{/if}}
</section>
