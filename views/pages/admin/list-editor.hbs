<header class="admin-head">
  <div class="admin-head__text">
    <h1>{{pageTitle}}</h1>
    <p class="admin-head__lede">{{help}}</p>
  </div>
  <div class="admin-head__actions">
    {{#if publicHref}}<a class="button button--secondary button--small" href="{{publicHref}}" target="_blank" rel="noopener">{{icon "eye"}}See it on the site</a>{{/if}}
    <a class="button button--secondary button--small" href="/admin/lists/{{name}}/revisions">{{icon "clock"}}Revisions</a>
  </div>
</header>
{{#if privateList}}<p class="alert alert--note">{{icon "info"}}<span>This list stays in the database and is never copied to GitHub, because it holds people's private contact details.</span></p>{{/if}}
<noscript><p class="alert alert--error">The editor needs JavaScript.</p></noscript>
<form class="admin-editor" data-admin-editor novalidate>
  <script type="application/json" data-editor-config nonce="{{cspNonce}}">{{{editorJson}}}</script>
  <div class="panel admin-editor__panel" data-editor-root></div>
  <div class="admin-editor__bar">
    <div class="cluster">
      <button class="button" type="submit" data-save>Save</button>
      <span class="form-status" role="status" aria-live="polite" data-status>No changes yet</span>
    </div>
  </div>
</form>
