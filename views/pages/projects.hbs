<div class="container">
  <header class="page-head">
    {{> breadcrumbs}}
    <h1 class="matte-words">{{matteWords (t "projects.title")}}</h1>
    <p class="lead load-fade">{{t "projects.lead"}}</p>
  </header>

  <nav aria-label="{{t "projects.filterLabel"}}">
    <ul class="filters" role="list">
      {{#each filters}}
      <li><a class="filter{{#if id}} branch-{{id}}{{/if}}" href="{{href}}" {{#if active}}aria-current="page"{{/if}}>{{#if id}}<span class="pip" aria-hidden="true"></span>{{/if}}{{label}} <span class="filter__count">{{count}}<span class="visually-hidden"> {{tn "projects.project" count}}</span></span></a></li>
      {{/each}}
    </ul>
  </nav>

  {{#if withPages.length}}
  <h2 class="visually-hidden">{{t "projects.withPages"}}</h2>
  <ul class="project-list" role="list">
    {{#each withPages}}{{> project-row}}{{/each}}
  </ul>
  {{else}}
  <p class="alert alert--note">{{icon "info"}}<span>{{t "projects.empty"}} <a href="{{lp "/projects"}}">{{t "projects.showAll"}}</a>.</span></p>
  {{/if}}

  {{#if smaller.length}}
  <section class="section--tight section" aria-labelledby="smaller-title">
    <h2 id="smaller-title">{{t "projects.smaller"}}</h2>
    <p class="section-intro">{{t "projects.smallerIntro"}}</p>
    <ul class="small-list" role="list">
      {{#each smaller}}
      <li class="branch-{{branch}}" data-reveal>
        <p class="meta-line"><span>{{kind}}</span><span>{{period}}</span></p>
        <h3><span class="pip" aria-hidden="true"></span>{{title}}</h3>
        <p>{{summary}}</p>
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}
</div>
