<div class="container cv-page">
  <div class="cv-tools no-print">
    {{> breadcrumbs}}
    <div class="cluster">
      {{#if pdf}}<a class="button" href="{{pdf.href}}" download data-track="CV downloaded ({{lang}})">{{icon "arrow"}} {{labels.download}}</a>{{/if}}
      <a class="button button--secondary" href="{{labels.other.href}}" hreflang="{{labels.other.lang}}" lang="{{labels.other.lang}}">{{labels.other.label}}</a>
      {{#if pdf}}<p class="updated-note">{{labels.pdfMade}} {{#if (eq lang "de")}}{{longDateDe pdf.date}}{{else}}{{longDate pdf.date}}{{/if}}.</p>{{/if}}
    </div>
  </div>

  {{!-- One column on purpose: application systems read it top to bottom, and copy and paste comes out in order --}}
  <article class="cv-sheet" aria-labelledby="cv-name" lang="{{#if (eq lang "de")}}de{{else}}en-GB{{/if}}">
    <header class="cv-head{{#if photo}} cv-head--photo{{/if}}">
      {{#if photo}}
      <picture class="cv-photo">
        <source srcset="{{asset photo.webp}}" type="image/webp">
        <img src="{{asset photo.jpg}}" alt="{{labels.photoAlt}}" width="600" height="750">
      </picture>
      {{/if}}
      <div class="cv-head__text">
        <h1 id="cv-name">{{site.legal_name}}</h1>
        <p class="cv-headline">{{cv.headline}}</p>
        <ul class="cv-contact" role="list">
          {{#if cv.location}}<li>{{cv.location}}</li>{{/if}}
          {{#if phone}}<li><a href="{{telHref phone}}">{{phone}}</a></li>{{/if}}
          <li><a href="mailto:{{site.email}}">{{site.email}}</a></li>
          <li><a href="{{baseUrl}}">{{site.domain}}</a></li>
          {{#each profiles}}<li><a href="{{url}}">{{shortUrl url}}</a></li>{{/each}}
        </ul>
      </div>
      <img class="cv-mark" src="{{asset "images/brand/reece-dove-symbol-colour.svg"}}" alt="" width="72" height="58">
    </header>

    <section class="cv-section" aria-labelledby="cv-profile">
      <h2 id="cv-profile">{{labels.profile}}</h2>
      <p>{{cv.profile}}</p>
      {{#if cv.availability}}<p class="cv-availability">{{cv.availability}}</p>{{/if}}
    </section>

    <section class="cv-section" aria-labelledby="cv-education">
      <h2 id="cv-education">{{labels.education}}</h2>
      <ol class="cv-list" role="list">
        {{#each education}}
        <li class="cv-item">
          <p class="cv-when">{{when}}</p>
          <div>
            <h3>{{title}}{{#if place}}<span class="cv-place">, {{place}}</span>{{/if}}</h3>
            {{#if points.length}}<ul class="cv-points">{{#each points}}<li>{{this}}</li>{{/each}}</ul>{{else if text}}<p>{{text}}</p>{{/if}}
          </div>
        </li>
        {{/each}}
      </ol>
    </section>

    {{#if projects.length}}
    <section class="cv-section" aria-labelledby="cv-projects">
      <h2 id="cv-projects">{{labels.projects}}</h2>
      <ul class="cv-list" role="list">
        {{#each projects}}
        <li class="cv-item">
          <p class="cv-when">{{period}}</p>
          <div>
            <h3>{{#if url}}<a href="{{../baseUrl}}{{url}}">{{title}}</a>{{else}}{{title}}{{/if}}</h3>
            <p>{{text}}</p>
          </div>
        </li>
        {{/each}}
      </ul>
    </section>
    {{/if}}

    <section class="cv-section" aria-labelledby="cv-experience">
      <h2 id="cv-experience">{{labels.experience}}</h2>
      <ol class="cv-list" role="list">
        {{#each work}}
        <li class="cv-item">
          <p class="cv-when">{{when}}</p>
          <div>
            <h3>{{title}}{{#if place}}<span class="cv-place">, {{place}}</span>{{/if}}</h3>
            {{#if points.length}}<ul class="cv-points">{{#each points}}<li>{{this}}</li>{{/each}}</ul>{{else if text}}<p>{{text}}</p>{{/if}}
          </div>
        </li>
        {{/each}}
      </ol>
    </section>

    <section class="cv-section" aria-labelledby="cv-skills">
      <h2 id="cv-skills">{{labels.skills}}</h2>
      <dl class="cv-facts">
        {{#each skills}}
        <div><dt>{{group}}</dt><dd>{{#each items}}{{name}}{{#unless @last}}, {{/unless}}{{/each}}</dd></div>
        {{/each}}
      </dl>
    </section>

    <section class="cv-section" aria-labelledby="cv-languages">
      <h2 id="cv-languages">{{labels.more}}</h2>
      <dl class="cv-facts">
        {{#if cv.languages.length}}<div><dt>{{labels.languages}}</dt><dd>{{#each cv.languages}}{{name}} ({{level}}){{#unless @last}}, {{/unless}}{{/each}}</dd></div>{{/if}}
        {{#if cv.extras.length}}<div><dt>{{labels.also}}</dt><dd>{{#each cv.extras}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</dd></div>{{/if}}
      </dl>
    </section>

    {{#if cv.interests}}
    <section class="cv-section" aria-labelledby="cv-interests">
      <h2 id="cv-interests">{{labels.interests}}</h2>
      <p>{{cv.interests}}</p>
    </section>
    {{/if}}

    {{#if referees.length}}
    <section class="cv-section" aria-labelledby="cv-references">
      <h2 id="cv-references">{{labels.references}}</h2>
      <ul class="cv-plain" role="list">
        {{#each referees}}
        <li><strong>{{name}}</strong>, {{role}}, {{organisation}}{{#if contact_public}}{{#if email}}, <a href="mailto:{{email}}">{{email}}</a>{{/if}}{{#if phone}}, {{phone}}{{/if}}{{/if}}</li>
        {{/each}}
      </ul>
      {{#unless allContactsPublic}}<p class="cv-note">{{labels.contactOnRequest}}</p>{{/unless}}
    </section>
    {{/if}}
  </article>
</div>
