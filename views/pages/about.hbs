<div class="container">
  <header class="page-head">
    {{> breadcrumbs}}
    <div class="about-intro">
      <div>
        <h1 class="matte-words">{{matteWords "About me"}}</h1>
        <p class="lead load-fade">{{page.lead}}</p>
      </div>
      <img class="about-mark theme-light-only" src="{{asset "images/brand/reece-dove-symbol-colour.svg"}}" alt="" width="144" height="117">
      <img class="about-mark theme-dark-only" src="{{asset "images/brand/reece-dove-symbol-colour-on-dark.svg"}}" alt="" width="144" height="117">
    </div>
  </header>

  <div class="with-aside about-section">
    <article class="prose" aria-label="My story">
      {{{page.html}}}
    </article>
    <aside class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">On this page</h2>
      <ol>
        {{#each page.headings}}<li><a href="#{{id}}">{{text}}</a></li>{{/each}}
        <li><a href="#experience">Experience and education</a></li>
        <li><a href="#skills">Skills</a></li>
      </ol>
    </aside>
  </div>
</div>

<section class="section section--sunken" aria-labelledby="experience">
  <div class="container with-aside with-aside--left">
    <div class="timeline-head">
      <h2 id="experience">Experience and education</h2>
      <div class="timeline-legend" aria-hidden="true">
        <span><i></i>Education</span>
        <span class="is-work"><i></i>Work</span>
      </div>
    </div>
    <ol class="timeline" role="list">
      {{#each timeline}}
      <li class="timeline__item{{#if (eq kind "work")}} is-work{{/if}}{{#if planned}} is-planned{{/if}}" data-reveal>
        {{!-- The heading comes first so screen reader users jumping by heading land on it, CSS shows the date above --}}
        <h3>{{title}}</h3>
        <p class="timeline__when">{{when}}<span class="visually-hidden">, {{#if (eq kind "work")}}work{{else}}education{{/if}}{{#if planned}}, planned{{/if}}</span></p>
        <p class="timeline__place">{{place}}</p>
        <p>{{text}}</p>
      </li>
      {{/each}}
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="skills">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 id="skills">Skills</h2>
        <p class="section-intro">No percentages or star ratings. Each skill links to the work that shows it, so you can judge for yourself.</p>
      </div>
    </div>
    <div class="skills">
      {{#each skills}}
      <div data-reveal>
        <h3>{{group}}</h3>
        <ul role="list">
          {{#each items}}
          <li>
            <span class="skill-name">{{name}}</span>
            {{#if (or evidence.length note)}}
            <p class="skill-evidence">
              {{#if evidence.length}}Shown in {{#each evidence}}<a href="{{url}}">{{title}}</a>{{#unless @last}}, {{/unless}}{{/each}}{{/if}}{{#if (and evidence.length note)}}. {{/if}}{{#if note}}{{note}}{{/if}}
            </p>
            {{/if}}
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </div>
</section>
