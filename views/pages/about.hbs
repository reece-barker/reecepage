<div class="container">
  <header class="page-head">
    {{> breadcrumbs}}
    <div class="about-intro">
      <div>
        <h1 class="matte-words">{{matteWords page.title}}</h1>
        <p class="lead load-fade">{{page.lead}}</p>
        {{#if (and (eq lang "de") (not page.translated))}}<p class="alert alert--note">{{icon "info"}}<span>{{t "about.notTranslated"}}</span></p>{{/if}}
      </div>
      <img class="about-mark theme-light-only" src="{{asset "images/brand/reece-dove-symbol-colour.svg"}}" alt="" width="144" height="117">
      <img class="about-mark theme-dark-only" src="{{asset "images/brand/reece-dove-symbol-colour-on-dark.svg"}}" alt="" width="144" height="117">
    </div>
  </header>

  {{#if branches.length}}
  {{!-- The three branches of the tree on the home page, what everything below grows from --}}
  <section class="about-branches" aria-labelledby="branches">
    <h2 id="branches">{{home.branches_heading}}</h2>
    <p class="section-intro">{{home.branches_intro}}</p>
    <ul class="branch-list branch-list--compact" role="list">
      {{#each branches}}
      <li class="branch-row branch-{{id}}">
        <h3><span class="pip" aria-hidden="true"></span>{{title}}</h3>
        <p>{{text}}</p>
        {{#if (eq id "faith")}}
        <a class="link-action" href="#{{#if (eq @root.lang "de")}}menschen{{else}}people{{/if}}">{{t "about.moreBelow"}} {{icon "arrow"}}</a>
        {{else}}
        <a class="link-action" href="{{lp "/projects"}}?branch={{id}}">{{t "about.branchProjects" title=title}} {{icon "arrow"}}</a>
        {{/if}}
      </li>
      {{/each}}
    </ul>
  </section>
  {{/if}}

  <div class="with-aside about-section">
    <article class="prose" aria-label="{{t "about.story"}}">
      {{{page.html}}}
    </article>
    <aside class="toc" aria-labelledby="toc-title">
      <h2 id="toc-title">{{t "about.onThisPage"}}</h2>
      <ol>
        {{#each page.headings}}<li><a href="#{{id}}">{{text}}</a></li>{{/each}}
        <li><a href="#experience">{{t "about.experience"}}</a></li>
        <li><a href="#skills">{{t "about.skills"}}</a></li>
      </ol>
    </aside>
  </div>
</div>

<section class="section section--sunken" aria-labelledby="experience">
  <div class="container with-aside with-aside--left">
    <div class="timeline-head">
      <h2 id="experience">{{t "about.experience"}}</h2>
      <div class="timeline-legend" aria-hidden="true">
        <span><i></i>{{t "about.education"}}</span>
        <span class="is-work"><i></i>{{t "about.work"}}</span>
      </div>
    </div>
    <ol class="timeline" role="list">
      {{#each timeline}}
      <li class="timeline__item{{#if (eq kind "work")}} is-work{{/if}}{{#if planned}} is-planned{{/if}}" data-reveal>
        {{!-- The heading comes first so screen reader users jumping by heading land on it, CSS shows the date above --}}
        <h3>{{title}}</h3>
        <p class="timeline__when">{{when}}<span class="visually-hidden">, {{#if (eq kind "work")}}{{t "about.work"}}{{else}}{{t "about.education"}}{{/if}}{{#if planned}}, {{t "about.planned"}}{{/if}}</span></p>
        <p class="timeline__place">{{place}}</p>
        <p>{{text}}</p>
      </li>
      {{/each}}
    </ol>
  </div>
</section>

<section class="section" aria-labelledby="skills">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 id="skills">{{t "about.skills"}}</h2>
        <p class="section-intro">{{t "about.skillsIntro"}}</p>
      </div>
    </div>
    <div class="skills">
      {{#each skills}}
      <div data-reveal>
        <h3>{{group}}</h3>
        <ul role="list">
          {{#each items}}
          <li>
            <span class="skill-name">{{name}}</span>
            {{#if (or evidence.length note)}}
            <p class="skill-evidence">
              {{#if evidence.length}}{{t "about.shownIn"}} {{#each evidence}}<a href="{{lp url}}">{{title}}</a>{{#unless @last}}, {{/unless}}{{/each}}{{/if}}{{#if (and evidence.length note)}}. {{/if}}{{#if note}}{{note}}{{/if}}
            </p>
            {{/if}}
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
    </div>
  </div>
</section>
