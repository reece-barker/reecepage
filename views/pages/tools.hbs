<div class="container">
  <header class="page-head">
    {{> breadcrumbs}}
    <h1>Tools</h1>
    <p class="lead">Small tools I build and run.</p>
  </header>
  <ul class="project-list" role="list">
    {{#each tools}}
    <li class="project-row branch-code">
      <div class="project-row__meta"><span>{{status}}</span></div>
      <div>
        <h2 class="project-row__title"><a href="{{url}}">{{title}}</a></h2>
        <p class="project-row__summary">{{summary}}</p>
      </div>
      <span class="project-row__arrow" aria-hidden="true">{{icon "arrow"}}</span>
    </li>
    {{/each}}
  </ul>
</div>
