<header class="admin-head">
  <div class="admin-head__text">
    <h1>Media</h1>
    <p class="admin-head__lede">Every picture and video on the site. Ticking Published lists one on the <a href="/media">media page</a>, a picture in a post shows there either way. The quickest way to put a picture in a post is the picture block in the editor, it uploads from there.</p>
  </div>
</header>

{{#if notice}}<div class="alert alert--success" role="status">{{icon "check"}}<span>{{notice}}</span></div>{{/if}}
{{#if error}}<div class="alert alert--error" role="alert">{{icon "alert"}}<span>{{error}}</span></div>{{/if}}

<div class="stack">
  <section class="panel" aria-labelledby="upload-title">
    <div class="panel__head"><h2 id="upload-title">Upload</h2><p>Pictures up to {{limits.imageMb}} MB, videos up to {{limits.videoMb}} MB</p></div>
    <form class="media-upload" data-media-upload data-csrf="{{csrfToken}}" novalidate>
      <div class="media-upload__grid">
        <div class="field media-upload__file">
          <label class="label" for="upload-file">File</label>
          <input class="input" id="upload-file" name="file" type="file" accept="image/jpeg,image/png,image/webp,image/avif,video/mp4,video/webm" aria-describedby="upload-file-hint" required>
          <p class="hint" id="upload-file-hint">JPEG, PNG, WebP or AVIF. MP4 (H.264) or WebM for video.</p>
        </div>
        <div class="field">
          <label class="label" for="upload-title-input">Title</label>
          <input class="input" id="upload-title-input" name="title" type="text" maxlength="160" required>
        </div>
        <div class="field">
          <label class="label" for="upload-alt">What it shows (alt text)</label>
          <input class="input" id="upload-alt" name="alt" type="text" maxlength="300" aria-describedby="upload-alt-hint">
          <p class="hint" id="upload-alt-hint">Needed for pictures. Say what's in it, as you would on the phone.</p>
        </div>
        <div class="field">
          <label class="label" for="upload-caption">Caption (optional)</label>
          <input class="input" id="upload-caption" name="caption" type="text" maxlength="2000">
        </div>
        <div class="field">
          <label class="label" for="upload-credit">Credit or licence (optional)</label>
          <input class="input" id="upload-credit" name="credit" type="text" maxlength="1000">
        </div>
      </div>
      <div class="panel__foot">
        <button class="button button--small" type="submit" data-submit>{{icon "upload"}}<span data-submit-label>Upload</span></button>
        <progress max="100" value="0" hidden data-upload-progress aria-label="Upload progress"></progress>
        <p class="form-status" role="status" aria-live="polite" data-upload-status></p>
      </div>
    </form>
  </section>

  <section class="panel" aria-labelledby="library-admin-title">
    <div class="panel__head"><h2 id="library-admin-title">Library <span class="panel__count">{{length items}}</span></h2><p>Open one to change its text, publish it or delete it</p></div>
    {{#unless items.length}}<div class="admin-empty admin-empty--big">{{icon "image"}}<p>Nothing uploaded yet.</p></div>{{/unless}}
    <ul class="media-grid" role="list">
      {{#each items}}
      <li class="media-card" id="item-{{id}}">
        <div class="media-card__preview">
          {{#if isVideo}}
          <video controls preload="metadata" {{#if posterSrc}}poster="{{posterSrc}}"{{/if}} src="{{src}}"></video>
          {{else}}
          <img src="{{src}}" alt="" loading="lazy">
          {{/if}}
        </div>
        <div class="media-card__body">
          <h3 class="media-card__title" id="title-{{id}}">{{title}}</h3>
          <p class="media-card__meta">{{#if published}}<span class="pill pill--published">Published</span>{{else}}<span class="pill pill--draft">Not published</span>{{/if}}{{#if featured}} <span class="pill pill--scheduled">On the home page</span>{{/if}}</p>
          <p class="media-card__meta">{{#if isVideo}}Video{{else}}Picture{{/if}}{{#if width}}, {{width}} x {{height}}{{/if}}{{#if durationSeconds}}, {{clock durationSeconds}}{{/if}}</p>
          <p class="media-card__code"><code>{{shortcode}}</code></p>
        </div>
        <details class="media-card__edit">
          <summary>Edit<span class="visually-hidden"> {{title}}</span></summary>
          <form class="form admin-media-item__form" method="post" action="/admin/media/{{id}}">
            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            <div class="field">
              <label class="label" for="title-input-{{id}}">Title</label>
              <input class="input" id="title-input-{{id}}" name="title" value="{{title}}" maxlength="160" required>
            </div>
            <div class="field">
              <label class="label" for="alt-{{id}}">What it shows (alt text)</label>
              <input class="input" id="alt-{{id}}" name="alt" value="{{alt}}" maxlength="300">
            </div>
            <div class="field">
              <label class="label" for="caption-{{id}}">Caption</label>
              <textarea class="textarea" id="caption-{{id}}" name="caption" rows="2" maxlength="2000">{{caption}}</textarea>
            </div>
            <div class="field">
              <label class="label" for="credit-{{id}}">Credit</label>
              <input class="input" id="credit-{{id}}" name="credit" value="{{credit}}" maxlength="1000">
            </div>
            <label class="check"><input type="checkbox" name="published" {{#if published}}checked{{/if}}> <span>Published on the media page</span></label>
            {{#if isVideo}}<label class="check"><input type="checkbox" name="featured" {{#if featured}}checked{{/if}}> <span>The video on the home page</span></label>{{/if}}
            <div class="cluster"><button class="button button--small" type="submit">Save</button></div>
          </form>
          {{#if isVideo}}
          <div class="admin-media-item__extras">
            <form class="form" data-media-extra="captions" data-id="{{id}}" data-csrf="{{../csrfToken}}">
              <label class="label" for="captions-{{id}}">Captions (.vtt or .srt){{#if captionsSrc}}, replaces the current ones{{/if}}</label>
              <input class="input" id="captions-{{id}}" type="file" accept=".vtt,.srt,text/vtt">
              <button class="button button--secondary button--small" type="submit">Add captions</button>
              <p class="form-status" role="status" aria-live="polite"></p>
            </form>
            <form class="form" data-media-extra="poster" data-id="{{id}}" data-csrf="{{../csrfToken}}">
              <label class="label" for="poster-{{id}}">Poster picture (shown before it plays)</label>
              <input class="input" id="poster-{{id}}" type="file" accept="image/jpeg,image/png,image/webp,image/avif">
              <button class="button button--secondary button--small" type="submit">Set poster</button>
              <p class="form-status" role="status" aria-live="polite"></p>
            </form>
          </div>
          {{/if}}
          <form method="post" action="/admin/media/{{id}}/delete" class="admin-media-item__delete" data-confirm-delete>
            <input type="hidden" name="_csrf" value="{{../csrfToken}}">
            <button class="qbutton qbutton--danger" type="submit" data-delete-button>Delete {{title}}</button>
          </form>
        </details>
      </li>
      {{/each}}
    </ul>
  </section>
</div>
