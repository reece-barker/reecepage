<section class="grove" aria-labelledby="hero-title" data-grove>
  <div class="grove__intro">
    <h1 class="hero-name matte-words" id="hero-title">{{matteWords site.name}}</h1>
    <p class="hero-lede load-fade load-fade--2">{{home.hero_lede}}</p>
    <div class="hero-actions load-fade load-fade--3">
      <a class="button" href="/projects" data-track="Home: see projects">{{home.hero_button}} {{icon "arrow"}}</a>
      <a class="link-action" href="/contact" data-track="Home: get in touch">{{home.hero_link}}</a>
    </div>
  </div>

  <div class="grove__stage" aria-hidden="true" data-tree-stage>
    <img class="grove__poster theme-light-only" src="{{asset "images/tree/tree-poster-light.webp"}}" alt="" width="900" height="900" fetchpriority="low">
    <img class="grove__poster theme-dark-only" src="{{asset "images/tree/tree-poster-dark.webp"}}" alt="" width="900" height="900" fetchpriority="low">
    <canvas data-tree-canvas></canvas>
  </div>

  <div class="grove__branches">
    <h2>{{home.branches_heading}}</h2>
    <p class="section-intro">{{home.branches_intro}} <span class="grove__hint" aria-hidden="true">Point at a branch and it lights up on the tree.</span></p>
    <ul class="branch-list" role="list">
      {{#each branches}}
      <li class="branch-row branch-{{id}}" data-limb="{{limb}}">
        <h3><span class="pip" aria-hidden="true"></span>{{title}}</h3>
        <p>{{text}}</p>
        {{#if (eq id "faith")}}
        <a class="link-action" href="/about#people">More about me {{icon "arrow"}}</a>
        {{else}}
        <a class="link-action" href="/projects?branch={{id}}">{{title}} projects {{icon "arrow"}}</a>
        {{/if}}
      </li>
      {{/each}}
    </ul>
  </div>
</section>

{{#if intro}}
<section class="section home-intro" aria-labelledby="intro-title">
  <div class="container home-intro__grid">
    <div class="home-intro__text">
      <h2 id="intro-title">{{home.intro_heading}}</h2>
      {{#if intro.durationSeconds}}<p class="updated-note">A video introduction, {{clock intro.durationSeconds}} long{{#if intro.captionsSrc}}, with captions{{/if}}</p>{{/if}}
      <p>{{#if intro.caption}}{{intro.caption}}{{else}}{{home.intro_text}}{{/if}}</p>
      <p><a class="link-action" href="/media">More on the media page {{icon "arrow"}}</a></p>
    </div>
    <div class="home-intro__video">{{{introHtml}}}</div>
  </div>
</section>

{{/if}}
<section class="section section--sunken" aria-labelledby="work-title">
  <div class="container">
    <div class="section-head">
      <div>
        <h2 id="work-title">{{home.work_heading}}</h2>
        <p class="section-intro">{{home.work_intro}}</p>
      </div>
      <a class="link-action" href="/projects">All projects {{icon "arrow"}}</a>
    </div>
    <ul class="project-list" role="list">
      {{#each featured}}{{> project-row}}{{/each}}
    </ul>
  </div>
</section>

{{#if now}}
<section class="section" aria-labelledby="now-title">
  <div class="container home-now">
    <div>
      <h2 id="now-title">Right now</h2>
      <p class="updated-note">Updated <time datetime="{{isoDate now.updated}}">{{longDate now.updated}}</time></p>
    </div>
    <div>
      <ul class="now-list" role="list">
        {{#each now.items}}
        <li data-reveal>
          <span class="pip" aria-hidden="true"></span>
          <h3>{{#if link}}<a href="{{link}}">{{title}}</a>{{else}}{{title}}{{/if}}</h3>
          <p>{{text}}</p>
        </li>
        {{/each}}
      </ul>
      {{#if now.next}}
      <div class="now-next">
        <h3>Next</h3>
        <ul>{{#each now.next}}<li>{{this}}</li>{{/each}}</ul>
      </div>
      {{/if}}
    </div>
  </div>
</section>
{{/if}}

<section class="section" aria-labelledby="hi-title">
  <div class="container home-contact">
    <h2 id="hi-title">{{home.contact_heading}}</h2>
    <p class="lead">{{home.contact_lead}}</p>
    <a class="email-link" href="mailto:{{site.email}}" data-track="Email link">{{site.email}}</a>
    <div class="cluster">
      <a class="button button--secondary" href="/contact" data-track="Home: send a message">{{home.contact_button}} {{icon "arrow"}}</a>
      {{#if latest}}<a class="link-action" href="{{latest.url}}">Latest writing: {{latest.title}}</a>{{/if}}
    </div>
  </div>
</section>
