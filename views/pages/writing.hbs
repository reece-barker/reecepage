<div class="container">
  <header class="page-head">
    {{> breadcrumbs}}
    <h1 class="matte-words">{{matteWords (t "writing.title")}}</h1>
    <p class="lead load-fade">{{t "writing.lead"}} <a href="/writing/feed.xml">{{t "writing.feed"}}</a>.</p>
    {{#if (eq lang "de")}}<p class="alert alert--note">{{icon "info"}}<span>{{t "writing.englishOnly"}}</span></p>{{/if}}
  </header>
  {{#if articles.length}}
  <ul class="project-list" role="list">
    {{#each articles}}
    <li class="project-row branch-code" data-reveal>
      <div class="project-row__meta">
        <time datetime="{{isoDate date}}">{{longDate date}}</time>
        <span>{{t "writing.minutes" count=readingMinutes}}</span>
      </div>
      <div>
        <h2 class="project-row__title"><a href="{{lp url}}" data-match-cut="{{slug}}" lang="en">{{title}}</a></h2>
        <p class="project-row__summary">{{summary}}</p>
      </div>
      <span class="project-row__arrow" aria-hidden="true">{{icon "arrow"}}</span>
    </li>
    {{/each}}
  </ul>
  {{else}}
  <p class="alert alert--note">{{icon "info"}}<span>{{t "writing.empty"}}</span></p>
  {{/if}}
</div>
