<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand-link" href="{{lp "/"}}" {{#if (eq currentPath "/")}}aria-current="page"{{/if}}>
      <img class="theme-light-only" src="{{asset "images/brand/reece-dove-long-horizontal-colour.svg"}}" alt="{{t "brand.home"}}" width="150" height="40">
      <img class="theme-dark-only" src="{{asset "images/brand/reece-dove-long-horizontal-colour-on-dark.svg"}}" alt="{{t "brand.home"}}" width="150" height="40">
    </a>
    <nav class="site-nav" aria-label="{{t "nav.main"}}">
      <button class="icon-button menu-button" type="button" aria-expanded="false" aria-controls="site-nav-list" data-menu-button>
        {{icon "menu"}}<span>{{t "nav.menu"}}</span>
      </button>
      <ul class="site-nav__list" id="site-nav-list" role="list">
        {{#each primaryNav}}
        <li><a class="site-nav__link" href="{{href}}" {{#if (isCurrent path ../currentPath)}}aria-current="{{#if (eq path ../currentPath)}}page{{else}}true{{/if}}"{{/if}}>{{label}}</a></li>
        {{/each}}
      </ul>
      {{!-- A details element, so the language links work without any script. The script only adds closing on Escape, on a click outside and when focus leaves --}}
      <details class="language-menu no-print" data-language-menu>
        <summary class="icon-button language-menu__button" aria-label="{{languageLabel}}">
          {{icon "globe"}}<span class="language-menu__code" aria-hidden="true">{{languageShort}}</span>{{icon "chevron"}}
        </summary>
        <ul class="language-menu__menu" role="list">
          {{#each languageLinks}}
          <li><a class="language-menu__link" href="{{href}}" lang="{{code}}" hreflang="{{code}}" {{#if current}}aria-current="true"{{/if}}><span>{{name}}</span><span class="language-menu__short" aria-hidden="true">{{short}}</span></a></li>
          {{/each}}
        </ul>
      </details>
      <button class="icon-button no-js-hidden" type="button" data-theme-toggle data-label-dark="{{t "nav.useDark"}}" data-label-light="{{t "nav.useLight"}}" aria-label="{{t "nav.useDark"}}">
        <span class="theme-light-only">{{icon "moon"}}</span>
        <span class="theme-dark-only">{{icon "sun"}}</span>
      </button>
    </nav>
  </div>
</header>
